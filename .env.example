# SplitEase local config — copy to .env for local runs (never commit .env).
# The receipt reader lives at /api/receipt on the deployed web app; set
# EXPO_PUBLIC_API_URL to that origin for native builds or local dev
# (e.g. EXPO_PUBLIC_API_URL=https://splitease.vercel.app). When empty,
# the web app uses its own /api/receipt and native builds fall back to
# the on-device demo parser. No Gemini key ever belongs in this file.
EXPO_PUBLIC_API_URL=
